# Copy to .env - all settings are prefixed AIM_
AIM_DEBUG=true
AIM_CORS_ORIGINS=["http://localhost:5173"]

# Which modules to mount; empty/unset means "everything discovered"
# AIM_ENABLED_MODULES=["chat"]

# Demo chat module: mock (default, no key needed) or anthropic
AIM_LLM_PROVIDER=mock
# AIM_ANTHROPIC_API_KEY=sk-ant-...
# AIM_ANTHROPIC_MODEL=claude-sonnet-4-5
